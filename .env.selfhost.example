# Copy to .env.selfhost and replace the password with a long random value.
WOOBLE_DB_PASSWORD=replace-with-a-random-alphanumeric-password

# Required immutable release tag; source builds still use this value for metadata.
WOOBLE_VERSION=replace-with-release-tag
# Keep the default project name for normal installs; use a unique name for isolated runs.
WOOBLE_COMPOSE_PROJECT_NAME=wooble

# Select one access overlay: local, private, or domain.
WOOBLE_MODE=local
# Exact browser origin including scheme and optional port, without a path or trailing slash.
# Local mode uses Caddy internal TLS; trust its local root certificate in your browser.
WOOBLE_ORIGIN=https://localhost:8080
WOOBLE_HTTP_PORT=8080

# Private mode only: bind to a specific private interface and use the host from WOOBLE_ORIGIN.
WOOBLE_BIND_ADDRESS=192.0.2.10
WOOBLE_CADDY_HOST=192.0.2.10

# Domain mode only; Caddy obtains and renews public certificates automatically.
WOOBLE_DOMAIN=wooble.example.com

# Keep the network, static addresses, and API trusted CIDRs aligned when customizing.
WOOBLE_PROXY_SUBNET=172.30.0.0/24
WOOBLE_CADDY_IP=172.30.0.2
WOOBLE_API_IP=172.30.0.3
# Caddy's trusted upstream proxy ranges (set only when an upstream proxy is used).
CADDY_TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Must always include Caddy's proxy-network peer plus any explicitly approved upstream proxy ranges.
TRUSTED_PROXY_CIDRS=172.30.0.2/32
