# Copy to .env.selfhost. Use a long random alphanumeric password.
WOOBLE_DB_PASSWORD=replace-with-a-random-alphanumeric-password

# Set this to the browser origin that reaches the reverse proxy.
# For local Docker: http://localhost:8080
# For a public HTTPS reverse proxy: https://wooble.example.com
WOOBLE_ORIGIN=http://localhost:8080
WOOBLE_HTTP_PORT=8080
