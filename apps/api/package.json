{
  "name": "@wooble/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint --error-on-warnings src",
    "test": "bun --env-file=../../.env test tests",
    "test:isolated": "bash scripts/test-isolated.sh",
    "admin:promote": "bun --env-file=../../.env scripts/promote-admin.ts"
  },
  "dependencies": {
    "@elysia/cors": "^1.4.2",
    "@wooble/contracts": "workspace:*",
    "@wooble/db": "workspace:*",
    "@wooble/domain": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "elysia": "^1.4.30",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}
