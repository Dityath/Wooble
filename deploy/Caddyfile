{
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXY_CIDRS}
	}
}

{$WOOBLE_CADDY_SITE} {
	{$WOOBLE_CADDY_TLS}
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3001
	}

	handle /health {
		reverse_proxy api:3001
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
