#!/usr/bin/env bash
set -Eeuo pipefail

# Small, dependency-free operator CLI. Values are read from Compose's dotenv file
# without evaluating it as shell code; Compose itself remains the env parser.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${WOOBLE_ENV_FILE:-$ROOT/.env.selfhost}"
COMPOSE_BASE=( -f "$ROOT/compose.selfhost.yml" )

fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
read_env() {
  local key="$1"
  [[ -f "$ENV_FILE" ]] || return 0
  awk -v wanted="$key" 'BEGIN { FS="=" } /^[[:space:]]*#/ || NF < 2 { next } { k=$1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", k); if (k == wanted) { sub(/^[^=]*=/, ""); gsub(/^\"|\"$/, ""); gsub(/^\047|\047$/, ""); print; exit } }' "$ENV_FILE"
}
read_setting() {
  local key="$1"
  if [[ ${!key+x} ]]; then printf '%s' "${!key}"; else read_env "$key"; fi
}
MODE="$(read_setting WOOBLE_MODE)"
MODE="${MODE:-local}"
PROJECT="$(read_setting WOOBLE_COMPOSE_PROJECT_NAME)"
PROJECT="${PROJECT:-wooble}"
LEGACY_PROJECT="$(read_setting WOOBLE_LEGACY_PROJECT_NAME)"
VERSION="$(read_setting WOOBLE_VERSION)"
case "$MODE" in
  local|private|domain) COMPOSE_MODE="$ROOT/compose.selfhost.$MODE.yml" ;;
  *) fail "WOOBLE_MODE must be local, private, or domain" ;;
esac
[[ -f "$ENV_FILE" ]] || fail "environment file not found: $ENV_FILE (copy .env.selfhost.example first)"
[[ "$PROJECT" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || fail "invalid WOOBLE_COMPOSE_PROJECT_NAME"
if [[ -n "$LEGACY_PROJECT" && ! "$LEGACY_PROJECT" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then fail "invalid WOOBLE_LEGACY_PROJECT_NAME"; fi
duplicates="$(awk -F= '
  /^[[:space:]]*#/ || NF < 2 { next }
  { key=$1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", key); count[key]++ }
  END { for (key in count) if (count[key] > 1 && key ~ /^(WOOBLE_(VERSION|MODE|COMPOSE_PROJECT_NAME|LEGACY_PROJECT_NAME|ORIGIN|HTTP_PORT|BIND_ADDRESS|CADDY_HOST|DOMAIN|PROXY_SUBNET|CADDY_IP|API_IP|DB_PASSWORD)|CADDY_TRUSTED_PROXY_CIDRS|TRUSTED_PROXY_CIDRS)$/) print key }
' "$ENV_FILE")"
[[ -z "$duplicates" ]] || fail "duplicate self-host settings in env file: ${duplicates//$'\n'/, }"

compose() {
  docker compose --env-file "$ENV_FILE" --project-name "$PROJECT" "${COMPOSE_BASE[@]}" -f "$COMPOSE_MODE" "$@"
}
compose_config_check() {
  compose config -q >/dev/null 2>&1 || fail "Compose configuration is invalid; check WOOBLE_VERSION, WOOBLE_ORIGIN, WOOBLE_BIND_ADDRESS, WOOBLE_DB_PASSWORD, and mode-specific settings"
}
version_required() {
  [[ "$VERSION" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]] || fail "WOOBLE_VERSION is required and must be a release version"
}

# Reuse only the selected Compose project or a legacy project the operator
# explicitly named. `postgres-data` is a common logical key, so the key alone
# never identifies a Wooble volume. The selected project is never rewritten.
resolve_project() {
  local volumes name labels logical owner count=0 invalid=0 chosen="" expected_name
  volumes="$(docker volume ls --filter label=com.docker.compose.volume=postgres-data --format '{{.Name}}')" || fail "cannot discover Docker volumes"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    labels="$(docker volume inspect --format '{{ index .Labels "com.docker.compose.volume" }}|{{ index .Labels "com.docker.compose.project" }}' "$name" 2>/dev/null)" || {
      [[ "$name" == wooble_postgres-data || ( -n "$LEGACY_PROJECT" && "$name" == "${LEGACY_PROJECT}_postgres-data" ) ]] && invalid=$((invalid + 1))
      continue
    }
    logical="${labels%%|*}"; owner="${labels#*|}"
    if [[ "$owner" != "$PROJECT" && ( -z "$LEGACY_PROJECT" || "$owner" != "$LEGACY_PROJECT" ) ]]; then continue; fi
    expected_name="${owner}_postgres-data"
    if [[ "$logical" != postgres-data || ! "$owner" =~ ^[a-z0-9][a-z0-9_-]*$ || "$name" != "$expected_name" ]]; then invalid=$((invalid + 1)); continue; fi
    count=$((count + 1)); chosen="$owner"
  done <<< "$volumes"
  if (( invalid > 0 )); then fail "invalid matching Wooble postgres-data volume labels found; refusing to guess which volume to reuse"; fi
  if (( count > 1 )); then fail "multiple matching Wooble postgres-data volumes found; set WOOBLE_COMPOSE_PROJECT_NAME to the intended project and resolve legacy ambiguity manually"; fi
  if (( count == 1 )) && [[ "$chosen" != "$PROJECT" ]]; then
    fail "legacy volume belongs to project '$chosen'; set WOOBLE_COMPOSE_PROJECT_NAME=$chosen explicitly to reuse it"
  fi
}

ensure_version_env() { version_required; }
backup() {
  local dir="$ROOT/backups" stamp file suffix=0
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  (umask 077; mkdir -p "$dir") || fail "cannot create backup directory"
  while :; do
    file="$dir/wooble-$stamp-$$-$suffix.dump"
    if [[ -e "$file" ]]; then suffix=$((suffix + 1)); continue; fi
    (umask 077; set -o noclobber; : > "$file") && break
    [[ -e "$file" ]] || fail "cannot create backup file"
    suffix=$((suffix + 1))
  done
  if ! compose exec -T postgres pg_dump -U wooble -Fc wooble > "$file"; then
    rm -f -- "$file"
    fail "backup failed"
  fi
  chmod 600 "$file"
  printf '%s\n' "$file"
}
restore_dump() {
  local file="$1"
  compose exec -T postgres pg_restore --clean --if-exists --no-owner -U wooble -d wooble < "$file"
}
recover_pre_restore() {
  compose stop web api || return 1
  restore_dump "$prebackup" || return 1
  compose run --rm migrate || return 1
  start_stack
}
start_stack() { compose up -d; }
# Runs inside the api container (bun) on the Compose proxy network and talks to
# the Caddy service ("web") on 443 exactly as a browser would: TLS with SNI and
# Host for the configured origin, verified against the supplied CA (stdin; empty
# means system roots). TLS verification is never disabled.
# PROBE_KIND=https expects 200 from /health; PROBE_KIND=ws sends an unauthenticated
# WebSocket upgrade for a deliberately invalid canvas id and expects 101, which only
# the API (not Caddy's static file server) can produce for /api/canvases/*/live.
read -r -d '' PROBE_SCRIPT <<'JS' || true
const tls = require("node:tls");
const kind = process.env.PROBE_KIND;
const origin = new URL(process.env.PROBE_ORIGIN);
const name = origin.hostname.replace(/^\[|\]$/g, "");
const ca = require("node:fs").readFileSync(0, "utf8").trim();
const isIp = /^[0-9.]+$/.test(name) || name.includes(":");
const ws = kind === "ws";
const path = ws ? "/api/canvases/diagnose/live" : "/health";
const headers = [`GET ${path} HTTP/1.1`, `Host: ${origin.host}`, "Connection: " + (ws ? "Upgrade" : "close")];
if (ws) headers.push("Upgrade: websocket", "Sec-WebSocket-Version: 13", "Sec-WebSocket-Key: d29vYmxlLWRpYWdub3NlIQ==", `Origin: ${origin.origin}`);
const socket = tls.connect({
  host: process.env.PROBE_TARGET,
  port: Number(process.env.PROBE_PORT || 443),
  servername: isIp ? undefined : name,
  ca: ca ? ca : undefined,
  checkServerIdentity: (_host, cert) => tls.checkServerIdentity(name, cert),
});
const fail = (why) => { console.error(why); process.exit(1); };
let data = "";
socket.setTimeout(10000, () => fail("timed out"));
socket.on("error", (error) => fail("TLS/connection error: " + error.message));
socket.on("secureConnect", () => socket.write(headers.join("\r\n") + "\r\n\r\n"));
socket.on("data", (chunk) => {
  data += chunk.toString("latin1");
  if (!data.includes("\r\n")) return;
  const status = Number(data.split(" ")[1]);
  if (ws ? status === 101 : status === 200) { console.log(`${kind} probe through Caddy: HTTP ${status}`); process.exit(0); }
  fail(`${kind} probe through Caddy: unexpected HTTP ${status}`);
});
socket.on("end", () => fail("connection closed before a response"));
JS

# Probe the public entry point (Caddy, the compose "web" service) from the api
# container, so the host only needs Docker Compose. Local/private modes use
# Caddy's internal CA, exported from the web container's data volume.
probe_caddy() {
  local kind="$1" origin="$2" ca=""
  if [[ "$MODE" != domain ]]; then
    ca="$(compose exec -T web cat /data/caddy/pki/authorities/local/root.crt 2>/dev/null)" || return 2
    [[ -n "$ca" ]] || return 2
  fi
  printf '%s\n' "$ca" | compose exec -T -e PROBE_KIND="$kind" -e PROBE_ORIGIN="$origin" -e PROBE_TARGET=web api bun -e "$PROBE_SCRIPT"
}
https_origin_matches_host() {
  local host="$1" origin="$2" expected_port="$3" port
  [[ "$expected_port" =~ ^[1-9][0-9]{0,4}$ ]] || return 1
  ((10#$expected_port <= 65535)) || return 1
  if [[ "$origin" == "https://$host" ]]; then
    ((10#$expected_port == 443))
    return
  fi
  [[ "$origin" == "https://$host:"* ]] || return 1
  port="${origin#"https://$host:"}"
  [[ "$port" =~ ^[1-9][0-9]{0,4}$ ]] || return 1
  ((10#$port >= 1 && 10#$port <= 65535 && 10#$port == 10#$expected_port))
}

cmd="${1:-}"; shift || true
case "$cmd" in
  install|up)
    ensure_version_env
    resolve_project
    compose_config_check
    if [[ "$cmd" == install ]]; then
      compose pull
      compose run --rm migrate
    fi
    start_stack || fail "stack start failed; inspect with deploy/wooble diagnose"
    ;;
  status)
    resolve_project
    compose ps
    ;;
  diagnose)
    version_required
    resolve_project
    printf 'mode=%s project=%s version=%s\n' "$MODE" "$PROJECT" "$VERSION"
    origin="$(read_setting WOOBLE_ORIGIN)"
    http_port="$(read_setting WOOBLE_HTTP_PORT)"
    case "$MODE" in
      local)
        https_origin_matches_host localhost "$origin" "$http_port" || fail "local mode requires an HTTPS localhost origin whose port matches WOOBLE_HTTP_PORT"
        ;;
      private)
        host="$(read_setting WOOBLE_CADDY_HOST)"
        bind="$(read_setting WOOBLE_BIND_ADDRESS)"
        [[ -n "$host" && -n "$bind" ]] || fail "private mode requires explicit WOOBLE_CADDY_HOST and WOOBLE_BIND_ADDRESS"
        https_origin_matches_host "$host" "$origin" "$http_port" || fail "private mode origin must use HTTPS and exactly match WOOBLE_CADDY_HOST and WOOBLE_HTTP_PORT"
        ;;
      domain)
        domain="$(read_setting WOOBLE_DOMAIN)"
        [[ -n "$domain" && "$origin" == "https://$domain" ]] || fail "domain mode origin must exactly match https://WOOBLE_DOMAIN"
        ;;
    esac
    compose_config_check
    compose ps
    printf 'note: HTTPS/WebSocket probes run from the api container against the Caddy service; Caddy'"'"'s CA is read from its data volume and TLS verification stays on\n'
    failed=0
    compose exec -T api bun -e 'fetch("http://127.0.0.1:3001/health").then(async r => { const body = await r.json(); console.log(JSON.stringify(body)); if (!r.ok) process.exit(1) }).catch(() => process.exit(1))' || { printf 'FAILED [api-internal]: API health check inside the api container failed; inspect migration and service logs\n' >&2; failed=1; }
    rc=0; probe_caddy https "$origin" || rc=$?
    if (( rc == 2 )); then printf 'FAILED [caddy-ca]: cannot read Caddy'"'"'s CA from the web container; is the web service running?\n' >&2; failed=1
    elif (( rc != 0 )); then printf 'FAILED [caddy-https]: %s/health was not served successfully through Caddy; check the web service, TLS, and proxy route\n' "${origin%%[?#]*}" >&2; failed=1
    else
      rc=0; probe_caddy ws "$origin" || rc=$?
      if (( rc != 0 )); then printf 'FAILED [caddy-websocket]: WebSocket upgrade through Caddy to the API live route did not return 101\n' >&2; failed=1; fi
    fi
    (( failed == 0 )) || fail "diagnose found failing layers (see FAILED lines above)"
    printf 'diagnose ok: API health, HTTPS through Caddy, and WebSocket upgrade through Caddy passed\n'
    ;;
  backup)
    resolve_project
    backup
    ;;
  restore)
    [[ "${1:-}" == "--confirm" && -n "${2:-}" && -z "${3:-}" ]] || fail "usage: deploy/wooble restore --confirm BACKUP.dump (explicit confirmation required)"
    file="$2"
    [[ -f "$file" ]] || fail "backup file does not exist"
    resolve_project
    # Stop writers first so the pre-restore backup captures every accepted write.
    # backup() only needs the postgres service, which stays running.
    if ! compose stop web api; then
      start_stack || true
      fail "could not stop web/API before restore; no backup or restore was attempted; attempted to restart stack"
    fi
    if ! prebackup="$(backup)"; then
      start_stack || true
      fail "automatic pre-restore backup failed; restore was not attempted; attempted to restart stack"
    fi
    if restore_dump "$file"; then
      if compose run --rm migrate; then
        if start_stack; then printf 'restore succeeded; migrations applied; pre-restore backup: %s\n' "$prebackup"; else
          printf 'restore stack start failed; attempting recovery from pre-restore backup %s\n' "$prebackup" >&2
          if recover_pre_restore; then fail "restore start failed; original data recovered and stack restarted; backup retained at $prebackup"; fi
          fail "restore start and automatic recovery failed; stack may be stopped; pre-restore backup retained at $prebackup"
        fi
      else
        printf 'migration after restore failed; attempting recovery from pre-restore backup %s\n' "$prebackup" >&2
        if recover_pre_restore; then fail "restore migrations failed; original data recovered and stack restarted; backup retained at $prebackup"; fi
        fail "restore migrations and automatic recovery failed; stack may be stopped; pre-restore backup retained at $prebackup"
      fi
    else
      printf 'restore failed; attempting recovery from pre-restore backup %s\n' "$prebackup" >&2
      if recover_pre_restore; then fail "restore failed; original data recovered and stack restarted; backup retained at $prebackup"; fi
      fail "restore and automatic recovery failed; stack may be stopped; both backups retained, recovery backup: $prebackup"
    fi
    ;;
  update)
    [[ -n "${1:-}" && -z "${2:-}" ]] || fail "usage: deploy/wooble update <version>"
    [[ "$1" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]] || fail "update version must be an exact release version"
    [[ -f "$ENV_FILE" ]] || fail "environment file not found"
    [[ ! -L "$ENV_FILE" ]] || fail "update requires a regular env file so its version can be persisted safely"
    original_env="$ENV_FILE"
    tmp_env="$(umask 077; mktemp "${original_env}.update.XXXXXX")" || fail "cannot prepare a safe env-file update"
    trap 'rm -f -- "${tmp_env:-}"' EXIT
    awk -v version="$1" '
      BEGIN { done=0 }
      {
        key=$0
        if (match(key, /^[[:space:]]*[^=[:space:]]+[[:space:]]*=/)) {
          key=substr(key, RSTART, RLENGTH)
          sub(/[[:space:]]*=$/, "", key)
          gsub(/[[:space:]]/, "", key)
          if (key == "WOOBLE_VERSION") { print "WOOBLE_VERSION=" version; done=1; next }
        }
        print
      }
      END { if (!done) print "WOOBLE_VERSION=" version }
    ' "$original_env" > "$tmp_env" || fail "cannot prepare a safe env-file update"
    chmod 600 "$tmp_env"
    resolve_project
    prebackup="$(backup)" || fail "update backup failed; update was not attempted"
    ENV_FILE="$tmp_env"
    export WOOBLE_VERSION="$1"
    compose pull api web migrate || fail "image pull failed; data unchanged; backup retained at $prebackup"
    if compose run --rm migrate; then
      if start_stack; then
        if mv -f "$tmp_env" "$original_env"; then
          tmp_env=""
          trap - EXIT
          printf 'updated to %s; version persisted; volume preserved; pre-update backup: %s\n' "$1" "$prebackup"
        else
          fail "stack started at the new version but could not persist WOOBLE_VERSION; original env file remains unchanged; backup retained at $prebackup"
        fi
      else
        fail "migration succeeded but stack start failed; original version retained; backup retained at $prebackup; restore it with deploy/wooble restore --confirm"
      fi
    else
      fail "migration failed; original version retained; previous services/data remain available where possible; backup retained at $prebackup; restore it with deploy/wooble restore --confirm"
    fi
    ;;
  *) fail "usage: deploy/wooble {install|up|status|diagnose|backup|restore --confirm BACKUP.dump|update VERSION}" ;;
esac
